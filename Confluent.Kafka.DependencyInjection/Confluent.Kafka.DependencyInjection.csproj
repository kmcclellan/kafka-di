<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net462;net8.0;net10.0</TargetFrameworks>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Confluent.Kafka</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AnalysisMode>all</AnalysisMode>
  </PropertyGroup>

  <PropertyGroup>
    <Title>Kafka Dependency Injection</Title>
    <Description>An extension of Confluent.Kafka for use with Microsoft.Extensions.DependencyInjection (and friends).</Description>
    <PackageTags>kafka;confluent;dependencyinjection;di;ioc;logging</PackageTags>
    <PackageProjectUrl>https://github.com/kmcclellan/kafka-di</PackageProjectUrl>
    <PackageReleaseNotes>https://github.com/kmcclellan/kafka-di/releases/v$(Version)</PackageReleaseNotes>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <Authors>Kyle McClellan and others</Authors>
    <Copyright>%A9 2020-2026 Kyle McClellan and others</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Confluent.Kafka" Version="2.16.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' Or '$(TargetFramework)' == 'net462'">
    <PackageReference Include="Microsoft.Bcl.TimeProvider" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md;..\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
